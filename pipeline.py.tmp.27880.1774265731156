class _T:
    """Lightweight timer context manager."""
    def __init__(self, name: str, store: dict):
        self._n = name; self._s = store
    def __enter__(self):
        self._t = time.perf_counter(); return self
    def __exit__(self, *_):
        self._s[self._n] = (time.perf_counter() - self._t) * 1000.0; return False


def _ensure_model(url: str, path: str) -> str:
    if os.path.exists(path):
        return path
    os.makedirs(os.path.dirname(path) or "models", exist_ok=True)
    print(f"[Download] {os.path.basename(path)} ...")
    urllib.request.urlretrieve(url, path)
    print(f"[Download] → {path}")
    return path


def _inward_feather(mask: np.ndarray, ksize: int, sigma: float) -> np.ndarray:
    """Gaussian blur for soft edges, clamped to never expand past original boundary.

    This is the core fix for the ghost-face-over-object problem:
    standard blur EXPANDS the mask outward, leaking swapped pixels onto
    occluding objects.  Inward-only blur creates soft edges only INSIDE
    the mask boundary.
    """
    boundary = (mask > 0.01).astype(np.float32)
    k = ksize | 1  # ensure odd
    blurred = cv2.GaussianBlur(mask, (k, k), sigma)
    return np.minimum(blurred, boundary)


def _inward_feather_aniso(mask: np.ndarray,
                          ksize_h: int, ksize_v: int,
                          sigma: float) -> np.ndarray:
    """Anisotropic inward-only Gaussian feather.

    Uses a wider horizontal kernel so the transition zone at the sides is
    softer than at the forehead/chin.  This compensates for the width
    mismatch between source and target faces: the wider horizontal gradient
    distributes the blend over more pixels, hiding any residual seam.

    Both axes are clamped to the original mask boundary so the swap never
    leaks outside the face region.
    """
    boundary = (mask > 0.01).astype(np.float32)
    kh = ksize_h | 1  # horizontal kernel — wider
    kv = ksize_v | 1  # vertical kernel  — narrower
    # Two-pass separable Gaussian: horizontal first, then vertical.
    # ksize=(kh, 1) = pure horizontal 1-D Gaussian;
    # ksize=(1, kv) = pure vertical 1-D Gaussian.
    blurred = cv2.GaussianBlur(mask, (kh, 1), sigma)   # horizontal pass
    blurred = cv2.GaussianBlur(blurred, (1, kv), sigma) # vertical pass
    return np.minimum(blurred, boundary)


