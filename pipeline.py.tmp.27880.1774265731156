class FailsafeManager:
    """Circular buffer + freeze + fade-to-black + fade-in."""

    def __init__(self, cfg: PipelineConfig, fps_est: float = 30.0):
        self._buf: deque = deque(maxlen=cfg.failsafe_buffer_size)
        self._freeze_limit = int(cfg.failsafe_freeze_seconds * fps_est)
        self._fade_out_n = cfg.failsafe_fade_out_frames
        self._fade_in_n = cfg.failsafe_fade_in_frames
        self._miss = 0
        self._returning = False
        self._return_cnt = 0
        self.state = "INACTIVE"

    def push_clean(self, frame: np.ndarray) -> None:
        self._buf.append(frame.copy())
        if self._returning:
            self._return_cnt += 1
            if self._return_cnt >= self._fade_in_n:
                self._returning = False
                self._return_cnt = 0
                self.state = "INACTIVE"
        self._miss = 0

    def on_miss(self) -> None:
        if self._miss == 0:
            self.state = "FREEZE"
            _fs_log.info("FREEZE — face lost")
        self._miss += 1
        if self._miss > self._freeze_limit:
            self.state = "FADE_BLACK"

    def on_return(self) -> None:
        if self._miss > 0:
            self._returning = True
            self._return_cnt = 0
            self.state = "FADE_IN"
            _fs_log.info("FADE_IN — face returned")

    def get_frame(self, current: Optional[np.ndarray] = None) -> np.ndarray:
        if self.state == "INACTIVE" and current is not None:
            return current
        if self.state == "FADE_IN" and current is not None:
            t = min(1.0, self._return_cnt / max(1, self._fade_in_n))
            frozen = self._buf[-1] if self._buf else current
            return cv2.addWeighted(current, t, frozen, 1.0 - t, 0)
        if self.state == "FADE_BLACK":
            if not self._buf:
                return np.zeros_like(current) if current is not None else np.zeros((1080, 1920, 3), dtype=np.uint8)
            base = self._buf[-1]
            t = min(1.0, (self._miss - self._freeze_limit) / max(1, self._fade_out_n))
            return cv2.addWeighted(base, 1.0 - t, np.zeros_like(base), t, 0)
        # FREEZE
        if self._buf:
            return self._buf[-1]
        return current if current is not None else np.zeros((1080, 1920, 3), dtype=np.uint8)


