"""Quick test for EyeRegionFixer — CPU only."""
import os
os.environ["CUDA_VISIBLE_DEVICES"] = ""  # force CPU

import numpy as np
import time

# Patch onnxruntime to avoid CUDA DLL crash
import onnxruntime as ort
_orig_init = ort.InferenceSession.__init__
def _cpu_init(self, *args, **kwargs):
    kwargs["providers"] = ["CPUExecutionProvider"]
    _orig_init(self, *args, **kwargs)
ort.InferenceSession.__init__ = _cpu_init

from src.enhancement.eye_region_fixer import EyeRegionFixer

fixer = EyeRegionFixer({"restore_model": "codeformer", "restore_strength": 0.6})
print("Restorer:", fixer._restorer_type)

img = np.random.randint(80, 200, (256, 256, 3), dtype=np.uint8)

# Warm up
fixer.fix(img, img)

t0 = time.perf_counter()
out = fixer.fix(img, img)
dt = (time.perf_counter() - t0) * 1000
print(f"fix() time (CPU): {dt:.1f} ms  shape: {out.shape}")
print(f"Pixel diff from input: {np.abs(out.astype(float) - img.astype(float)).mean():.1f}")
print("PASS" if out.shape == img.shape else "FAIL")
